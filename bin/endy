#!/usr/bin/env bash
# endy — single entry point to the endy multi-agent stack.
#
# Subcommands group together the underlying scripts so you have one CLI
# to remember. Tab completion is installed from scripts/endy-completion.sh.
#
# Lifecycle
#   endy install                      Symlink configs/skills/agents into ~/. (idempotent.)
#   endy start [--clean] [--no-attach] [--serve-opencode] [--logs]
#                                     Open the per-dir tmux session for cwd:
#                                     endy-<basename> (hash-suffixed on collision).
#   endy overview [--clean] [--no-attach]
#                                     Open the global aggregator session 'endy'.
#   endy orchestrator [name] [opts]   Open another orchestrator window for a cwd.
#   endy tmux-help                    Show tmux command hints in status/help window.
#   endy stop                         Kill the current cwd's endy session.
#   endy stop --session <name>        Kill one named endy tmux session.
#   endy stop --all                   Kill every endy* tmux session.
#   endy status                       Show tmux + Codex MCP + Tailscale status.
#   endy doctor                       Check python3, tmux, installed agents, config, and sessions.
#
# Agents (interactive — current cwd is the agent's project root)
#   endy codex [args]                 Start a Codex session here. Endy context is loaded
#                                     globally via ~/.codex/AGENTS.md (see 'endy install').
#   endy opencode [args]              Start OpenCode here.
#   endy cmd [args]                   Start CommandCode here.
#   endy hermes [args]                Start Hermes here.
#   endy <agent> --root               Run from the endy project root instead of cwd
#                                     (full endy context, ignore current project).
#
# Tasks
#   endy spawn <agent> [opts] -- <prompt>      Long unsupervised task in a tmux window.
#                                              Wraps scripts/spawn-long-task.sh; passes
#                                              --full-auto by default unless --supervised.
#   endy ask <agent> [opts] <prompt>           Short blocking call. Output to stdout.
#   endy chat <agent> [opts]                   Interactive agent in a tmux window.
#
# Watching
#   endy watch                        Read-only attach to the tmux session.
#   endy watch list                   Enriched status table.
#   endy watch tree [--all]           Group tasks by orchestrator and working directory.
#   endy watch dir <path>             Show tasks under one working directory.
#   endy watch log <id>               Follow one task's log (less +F).
#   endy watch chat <id>              Open an interactive chat for a task.
#   endy watch attach [<id>]          Read-only attach, optionally focusing a task window.
#   endy watch panel [--all]          Tile view of running tasks.
#   endy watch kill <id>              Kill a stuck task.
#   endy watch kill-all --agent X     Close all task/chat/follow windows for an agent.
#   endy watch kill-all --cwd DIR     Close all task/chat/follow windows under a dir.
#
# Web dashboard
#   endy web                          Start the web dashboard. Binds to your
#                                     Tailnet IP by default (so the phone can
#                                     reach it via Tailscale, no public exposure).
#   endy web --localhost              Bind to 127.0.0.1 only.
#   endy web --host <ip> --port <n>   Custom bind. Default port: 9120.
#                                     For shared-token auth, set ENDY_WEB_TOKEN
#                                     in the environment; clients pass it via
#                                     X-Endy-Token header or ?token= query.
#
# Help
#   endy help [<topic>]               This text or, with a topic, more detail.

set -u

# Resolve the endy project root, following any symlinks. macOS doesn't ship
# a `readlink -f`, so we dereference manually. This must work whether the
# script is invoked via its absolute path inside the repo or via a symlink
# in PATH (e.g. ~/.local/bin/endy).
_endy_self="${BASH_SOURCE[0]}"
while [[ -L "$_endy_self" ]]; do
  _endy_dir="$(cd "$(dirname "$_endy_self")" && pwd)"
  _endy_self="$(readlink "$_endy_self")"
  [[ "$_endy_self" != /* ]] && _endy_self="$_endy_dir/$_endy_self"
done
ENDY_ROOT="$(cd "$(dirname "$_endy_self")/.." && pwd)"
unset _endy_self _endy_dir
SCRIPTS="${ENDY_ROOT}/scripts"

# Per-directory session derivation (see scripts/lib/session.sh).
# SESSION/LOG_DIR are derived per invocation from $ENDY_SESSION / cwd. The
# old single-global-session "endy" behavior is reachable via 'endy overview'
# (which sets ENDY_SESSION=endy before dispatching).
# shellcheck source=../scripts/lib/session.sh
. "${SCRIPTS}/lib/session.sh"

# Derive once per invocation. Subcommands re-read so per-cmd overrides
# (e.g. --session flag in cmd_overview) work cleanly.
_endy_apply_session() {
  ENDY_SESSION="${ENDY_SESSION:-$(_endy_session_name "$(pwd)")}"
  ENDY_LOG_DIR="${ENDY_LOG_DIR:-$(_endy_log_dir "$ENDY_SESSION")}"
  SESSION="$ENDY_SESSION"
  LOG_DIR="$ENDY_LOG_DIR"
  export ENDY_SESSION ENDY_LOG_DIR ENDY_ROOT
}
_endy_apply_session

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

die() { echo "endy: $*" >&2; exit 1; }

doctor_version_line() {
  local bin="$1"
  if ! command -v python3 >/dev/null; then
    printf 'installed (version check skipped; python3 missing)\n'
    return 0
  fi

  python3 - "$bin" <<'PY'
import subprocess
import sys

binary = sys.argv[1]
try:
    result = subprocess.run(
        [binary, "--version"],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        timeout=2,
    )
except subprocess.TimeoutExpired:
    print("installed (version check timed out)")
except Exception:
    print("installed")
else:
    lines = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    preferred = [
        line for line in lines
        if not line.lower().startswith(("warning:", "update available"))
    ]
    line = preferred[0] if preferred else (lines[-1] if lines else "")
    print(line or "installed")
PY
}

show_help() {
  sed -n '2,62p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

# Extract the per-agent gotcha section from README.md so users don't have to
# context-switch to the file. The README's "Per-CLI gotchas" section uses
# `### <agent>` headings — we slice between one heading and the next `###`.
show_agent_help() {
  local agent="$1"
  local readme="${ENDY_ROOT}/README.md"
  [[ -f "$readme" ]] || die "README.md not found at $readme"

  # Map endy agent name → README heading prefix (literal substring match)
  local heading
  case "$agent" in
    opencode)        heading='### opencode' ;;
    cmd|commandcode) heading='### cmd' ;;
    hermes)          heading='### hermes' ;;
    claude)          heading='### claude' ;;
    tmux)            heading='### tmux specifics' ;;
    *) die "no help page for agent '$agent' — try: opencode, cmd, hermes, claude, tmux" ;;
  esac

  awk -v h="$heading" -v agent_label="$agent" '
    !in_section && index($0, h) == 1 {
      in_section=1
      print "endy help " agent_label
      print "──────────────────────────────────────────────"
      print; next
    }
    in_section && /^## /  { exit }
    in_section && /^### / { exit }
    in_section && /^---/  { exit }
    in_section { print }
  ' "$readme"
}

cmd_help() {
  if [[ $# -eq 0 ]]; then
    show_help
    return 0
  fi
  case "$1" in
    opencode|cmd|commandcode|hermes|claude|tmux) show_agent_help "$1" ;;
    -h|--help|help)
      cat <<'EOF'
endy help                Show top-level usage
endy help <agent>        Show per-CLI gotchas for an agent
                         agents: opencode, cmd, hermes, claude, tmux
EOF
      ;;
    *) die "no help topic '$1' — try: endy help <opencode|cmd|hermes|claude|tmux>" ;;
  esac
}

# Run an agent CLI with the endy project as the cwd if --root is passed,
# otherwise stay where we are. Either way, the AGENTS.md mechanism gives
# the agent its endy context.
run_agent() {
  local bin="$1"; shift
  local target_cwd="$(pwd)"
  local args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --root) target_cwd="$ENDY_ROOT"; shift ;;
      *)      args+=("$1"); shift ;;
    esac
  done
  cd "$target_cwd" || die "cannot cd to $target_cwd"
  exec "$bin" ${args[@]+"${args[@]}"}
}

# ---------------------------------------------------------------------------
# subcommands
# ---------------------------------------------------------------------------

cmd_install()  { exec "${SCRIPTS}/install.sh" "$@"; }
cmd_start()    { exec "${SCRIPTS}/start.sh"   --mode=per-dir "$@"; }
cmd_overview() {
  # Global aggregator — equivalent to today's `endy start`. Forces session "endy".
  ENDY_SESSION="endy" ENDY_LOG_DIR="${ENDY_ROOT}/.logs" \
    exec "${SCRIPTS}/start.sh" --mode=overview "$@"
}
cmd_status()   { exec "${SCRIPTS}/status.sh"  "$@"; }
cmd_watch()    { exec "${SCRIPTS}/endy-watch.sh" "$@"; }
cmd_web()      { exec python3 "${ENDY_ROOT}/web/server.py" "$@"; }
cmd_tmux_help(){ ENDY_SESSION="$SESSION" exec "${SCRIPTS}/tmux-help.sh" "$@"; }

safe_window_name() {
  printf '%s\n' "$1" | tr -cs '[:alnum:]_.-' '-' | sed 's/^-//; s/-$//; s/^$/orchestrator/'
}

focus_tmux_window() {
  local target="$1"
  tmux select-window -t "$target" 2>/dev/null || true
  if [[ -n "${TMUX:-}" ]]; then
    exec tmux switch-client -t "$target"
  fi
  exec tmux attach -t "$target"
}

cmd_stop() {
  local target="$SESSION"
  local stop_all=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all)               stop_all=1; shift ;;
      --session)           target="$2"; shift 2 ;;
      *) die "unknown stop arg: $1 (try --all or --session <name>)" ;;
    esac
  done

  if [[ "$stop_all" == "1" ]]; then
    local s any=0
    for s in $(tmux list-sessions -F '#S' 2>/dev/null | grep -E '^endy(-|$)'); do
      tmux kill-session -t "$s" 2>/dev/null && { echo "stopped: $s"; any=1; }
    done
    [[ "$any" == "0" ]] && echo "no endy* sessions running."
    return 0
  fi

  if tmux has-session -t "$target" 2>/dev/null; then
    tmux kill-session -t "$target"
    echo "endy session '$target' stopped."
  else
    echo "endy session '$target' not running."
  fi
}

cmd_doctor() {
  local ok=1
  printf 'tmux ............ '
  if command -v tmux >/dev/null; then printf '✓ %s\n' "$(tmux -V)"; else printf '✗ missing\n'; ok=0; fi
  printf 'python3 ......... '
  if command -v python3 >/dev/null; then printf '✓ %s\n' "$(python3 --version 2>&1)"; else printf '✗ missing\n'; ok=0; fi
  local agent_ok=0
  for bin in codex opencode cmd hermes; do
    printf '%-15s ' "$bin"
    if command -v "$bin" >/dev/null; then
      agent_ok=1
      printf '✓ %s\n' "$(doctor_version_line "$bin")"
    else
      printf '· not installed (optional)\n'
    fi
  done
  if [[ "$agent_ok" == "0" ]]; then
    printf 'agents ......... ✗ install at least one of: codex, opencode, cmd, hermes\n'
    ok=0
  fi
  printf 'AGENTS.md ....... '
  if [[ -L "${HOME}/.codex/AGENTS.md" || -f "${HOME}/.codex/AGENTS.md" ]]; then
    printf '✓ ~/.codex/AGENTS.md\n'
  else
    printf '✗ not installed (run: endy install)\n'; ok=0
  fi
  printf 'cmd model ....... '
  local cmd_cfg="${HOME}/.commandcode/config.json"
  if [[ -f "$cmd_cfg" ]]; then
    local cmd_model=""
    if command -v jq >/dev/null 2>&1; then
      cmd_model="$(jq -r '.model // empty' "$cmd_cfg" 2>/dev/null)"
    else
      # Fallback: grep the field. Tolerates spacing, single/double quotes.
      cmd_model="$(grep -oE '"model"[[:space:]]*:[[:space:]]*"[^"]*"' "$cmd_cfg" 2>/dev/null \
        | head -1 | sed -E 's/.*"([^"]*)"$/\1/')"
    fi
    if [[ -n "$cmd_model" && "$cmd_model" != "null" ]]; then
      printf '✓ %s\n' "$cmd_model"
    else
      printf '! no model set in %s — set with: cmd → /model\n' "$cmd_cfg"
    fi
  else
    printf '· no %s yet (cmd not yet configured)\n' "$cmd_cfg"
  fi
  printf 'tmux session .... '
  if tmux has-session -t "$SESSION" 2>/dev/null; then
    printf '✓ %s running\n' "$SESSION"
  else
    printf '· %s down (run: endy start)\n' "$SESSION"
  fi
  # Show any other endy* sessions so the user sees the per-dir landscape.
  local other_sessions
  other_sessions="$(tmux list-sessions -F '#S' 2>/dev/null | grep -E '^endy(-|$)' | grep -vx "$SESSION" || true)"
  if [[ -n "$other_sessions" ]]; then
    printf 'other endy ..... %s\n' "$(echo "$other_sessions" | tr '\n' ' ')"
  fi
  [[ "$ok" == "1" ]] || exit 1
}

cmd_orchestrator() {
  local name=""
  local agent="codex"
  local cwd="$(pwd)"
  local attach=1

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent)     agent="$2"; shift 2 ;;
      --cwd|--dir) cwd="$2"; shift 2 ;;
      --no-attach) attach=0; shift ;;
      *)           if [[ -z "$name" ]]; then name="$1"; else die "unexpected arg: $1"; fi; shift ;;
    esac
  done

  [[ -n "$name" ]] || name="$(basename "$cwd")"
  cd "$cwd" || die "cannot cd to $cwd"
  cwd="$(pwd)"

  if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    die "tmux session '$SESSION' is not running; run: endy start"
  fi

  local safe; safe="$(safe_window_name "$name")"
  local window="orch-${safe}"
  local target="${SESSION}:${window}"

  if tmux list-windows -t "$SESSION" -F '#W' 2>/dev/null | grep -qx "$window"; then
    echo "orchestrator window already exists: $target"
    echo "tmux commands:"
    echo "  tmux attach -t ${SESSION}"
    echo "  tmux select-window -t ${target}"
    [[ "$attach" == "1" ]] && focus_tmux_window "$target"
    return 0
  fi

  local argv=()
  case "$agent" in
    codex) argv=(codex) ;;
    opencode) argv=(opencode) ;;
    cmd|commandcode) argv=(cmd) ;;
    hermes) argv=(hermes chat) ;;
    *) die "unknown orchestrator agent: $agent" ;;
  esac

  local quoted_argv=""
  local a
  for a in "${argv[@]}"; do
    quoted_argv+=" $(printf '%q' "$a")"
  done
  local q_name; q_name="$(printf '%q' "$name")"
  local q_cwd; q_cwd="$(printf '%q' "$cwd")"
  local q_session; q_session="$(printf '%q' "$SESSION")"
  local q_log_dir; q_log_dir="$(printf '%q' "$LOG_DIR")"

  local script="
clear
export ENDY_ORCHESTRATOR=${q_name}
export ENDY_ORCHESTRATOR_CWD=${q_cwd}
export ENDY_ORCHESTRATOR_AGENT=$(printf '%q' "$agent")
export ENDY_SESSION=${q_session}
export ENDY_LOG_DIR=${q_log_dir}
printf '\033[1;36mendy orchestrator: %s\033[0m\n' ${q_name}
printf '\033[1;33mcwd: %s\033[0m\n' ${q_cwd}
printf '\033[1;33mtmux: Ctrl-b w windows | Ctrl-b d detach | Ctrl-b & kill window | Ctrl-b x kill pane\033[0m\n'
printf '\033[1;33mendy: endy watch tree | endy watch browse | endy watch dir %q\033[0m\n\n' ${q_cwd}
exec ${quoted_argv}
"
  tmux new-window -t "$SESSION" -n "$window" -c "$cwd" "bash -lc $(printf '%q' "$script")"
  tmux set-window-option -t "$target" remain-on-exit on 2>/dev/null || true

  echo "ORCHESTRATOR=${name}"
  echo "TMUX_WINDOW=${target}"
  echo "CWD=${cwd}"
  echo
  echo "tmux commands:"
  echo "  tmux attach -t ${SESSION}"
  echo "  tmux select-window -t ${target}"
  echo "  tmux kill-window -t ${target}"
  echo
  echo "endy commands:"
  echo "  endy watch tree"
  echo "  endy watch dir ${cwd}"
  echo "  endy watch browse"

  [[ "$attach" == "1" ]] && focus_tmux_window "$target"
  return 0
}

cmd_spawn() {
  local agent="${1:-}"
  [[ -n "$agent" ]] || die "usage: endy spawn <agent> [opts] -- <prompt>"
  shift

  # Default: --full-auto. User can override with --supervised.
  local supervised=0
  local prompt=""
  local prompt_file=""
  local extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --supervised) supervised=1; shift ;;
      --prompt-file) prompt_file="$2"; shift 2 ;;
      --prompt) prompt="$2"; shift 2 ;;
      --) shift; prompt="$*"; break ;;
      *) extra+=("$1"); shift ;;
    esac
  done

  if [[ -n "$prompt" && -n "$prompt_file" ]]; then
    die "pass either --prompt-file or a prompt after '--', not both"
  fi

  if [[ -z "$prompt" && -z "$prompt_file" ]]; then
    # Allow piping: endy spawn opencode [opts] < prompt.txt
    if [[ ! -t 0 ]]; then
      prompt="$(cat)"
    else
      die "no prompt — pass after '--' or pipe via stdin"
    fi
  fi

  local args=(--agent "$agent" ${extra[@]+"${extra[@]}"})
  if [[ -n "$prompt_file" ]]; then
    args+=(--prompt-file "$prompt_file")
  else
    args+=(--prompt "$prompt")
  fi
  [[ "$supervised" == "0" ]] && args+=(--full-auto)
  exec "${SCRIPTS}/spawn-long-task.sh" "${args[@]}"
}

cmd_ask() {
  # Short blocking call. Output goes to current stdout.
  local agent="${1:-}"
  [[ -n "$agent" ]] || die "usage: endy ask <agent> [opts] <prompt>"
  shift

  local extra=()
  local prompt=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --model) extra+=("$1" "$2"); shift 2 ;;
      --persona|--agent|--skills) extra+=("$1" "$2"); shift 2 ;;
      *) prompt+="${prompt:+ }$1"; shift ;;
    esac
  done

  [[ -n "$prompt" ]] || { [[ ! -t 0 ]] && prompt="$(cat)"; }
  [[ -n "$prompt" ]] || die "no prompt provided"

  case "$agent" in
    codex)
      exec codex exec ${extra[@]+"${extra[@]}"} "$prompt" ;;
    opencode)
      exec opencode run --dir "$(pwd)" ${extra[@]+"${extra[@]}"} "$prompt" ;;
    cmd|commandcode)
      exec cmd --skip-onboarding --trust ${extra[@]+"${extra[@]}"} -p "$prompt" ;;
    hermes)
      exec hermes chat -Q --accept-hooks ${extra[@]+"${extra[@]}"} -q "$prompt" ;;
    claude)
      exec claude ${extra[@]+"${extra[@]}"} -p "$prompt" ;;
    *)
      die "unknown agent: $agent" ;;
  esac
}

cmd_chat() {
  local agent="${1:-}"
  [[ -n "$agent" ]] || die "usage: endy chat <agent> [--persona X] [--model X] [--cwd DIR] [--resume ID] [--orchestrator X] [--orchestrator-agent X] [--full-auto] [--no-select]"
  shift

  local args=(--agent "$agent")
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --persona|--agent|--skills) args+=(--persona "$2"); shift 2 ;;
      --model)                    args+=(--model "$2"); shift 2 ;;
      --cwd)                      args+=(--cwd "$2"); shift 2 ;;
      --resume)                   args+=(--resume "$2"); shift 2 ;;
      --parent-task)              args+=(--parent-task "$2"); shift 2 ;;
      --orchestrator)             args+=(--orchestrator "$2"); shift 2 ;;
      --orchestrator-agent)       args+=(--orchestrator-agent "$2"); shift 2 ;;
      --full-auto)                args+=(--full-auto); shift ;;
      --no-select)                args+=(--no-select); shift ;;
      *) die "unknown chat arg: $1" ;;
    esac
  done

  exec "${SCRIPTS}/spawn-chat.sh" "${args[@]}"
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------

case "${1:-help}" in
  install)  shift; cmd_install "$@" ;;
  start)    shift; cmd_start "$@" ;;
  overview) shift; cmd_overview "$@" ;;
  orchestrator|orch) shift; cmd_orchestrator "$@" ;;
  tmux-help|help-tmux) shift; cmd_tmux_help "$@" ;;
  stop)     shift; cmd_stop "$@" ;;
  status)   shift; cmd_status "$@" ;;
  doctor)   shift; cmd_doctor "$@" ;;
  watch)    shift; cmd_watch "$@" ;;
  web)      shift; cmd_web "$@" ;;
  spawn)    shift; cmd_spawn "$@" ;;
  ask)      shift; cmd_ask "$@" ;;
  chat)     shift; cmd_chat "$@" ;;

  codex)    shift; run_agent codex "$@" ;;
  opencode) shift; run_agent opencode "$@" ;;
  cmd|commandcode) shift; run_agent cmd "$@" ;;
  hermes)   shift; run_agent hermes "$@" ;;
  claude)   shift; run_agent claude "$@" ;;

  help|-h|--help) shift; cmd_help "$@" ;;

  '') show_help ;;
  *)
    echo "endy: unknown subcommand '$1' — try 'endy help'" >&2
    exit 2
    ;;
esac
